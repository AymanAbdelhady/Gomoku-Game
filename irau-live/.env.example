# Sync mode: "auto" (default) detects the bundled realtime server at /api and
# falls back to same-browser local sync. Force with "local" or "server".
VITE_SYNC_MODE=auto

# Optional absolute URL of a separately hosted sync server (default: same origin /api).
# VITE_SYNC_URL=https://live.example.org/api

# PROTOTYPE ONLY: placeholder passcode for the operator screens.
# This is NOT real security — anything in VITE_* is visible in the browser bundle.
VITE_ADMIN_PASSCODE=gaza

# Server-side (npm run serve) — port and optional operator key for write actions.
# PORT=8787
# SYNC_OPERATOR_KEY=change-me
